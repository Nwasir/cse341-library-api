# Copy this file to .env and fill in your values. .env is ignored by git.
# On Render, add the same keys under Environment (config vars) instead.

# Required. The server will not start without it.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Optional. Database name to use (defaults to library).
MONGODB_DB_NAME=library

# Optional. Defaults to 3000.
PORT=3000

# Auth0 login. Everything here except BASE_URL is required.
# SECRET is any long random string. It encrypts the login cookie.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=<long random string>
# From the Auth0 application's Settings page: Client ID, Client Secret,
# and https:// + Domain.
CLIENT_ID=<Auth0 client id>
CLIENT_SECRET=<Auth0 client secret>
ISSUER_BASE_URL=https://<your-tenant>.us.auth0.com
# Optional. The url the app runs at (defaults to http://localhost:PORT).
# On Render set it to https://cse341-library-api-b2pm.onrender.com
BASE_URL=http://localhost:3000
