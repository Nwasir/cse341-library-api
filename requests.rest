@localhost = http://localhost:3000
@render = https://cse341-library-api-b2pm.onrender.com

# The Render section has the same requests as the localhost section.
#
# Send the requests in order: "Get a book by id" uses the first id from
# "Get all books", and the GET, PUT and DELETE requests after
# "Create a book" use the id that it returns. The author requests
# work the same way.
#
# Render's free plan sleeps when it isn't used, so the first Render
# request can take up to a minute.

########## Localhost ##########

### Home route
GET {{localhost}}/

### API documentation (Swagger UI). Open this url in a browser to try each route.
GET {{localhost}}/api-docs/

### A url that is not a route (404)
GET {{localhost}}/magazines

########## Localhost: books ##########

### Get all books
# @name localBooks
GET {{localhost}}/books

### Get a book by id (uses the first id from "Get all books" above)
GET {{localhost}}/books/{{localBooks.response.body.$[0]._id}}

### Get a book with an invalid id (400)
GET {{localhost}}/books/12345

### Get a book that does not exist (404)
GET {{localhost}}/books/000000000000000000000000

### Create a book (201, returns the new book's id)
# @name localNewBook
POST {{localhost}}/books
Content-Type: application/json

{
  "title": "No Longer at Ease",
  "author": "Chinua Achebe",
  "isbn": "9780385474559",
  "genre": "Fiction",
  "publishedYear": 1960,
  "pageCount": 194,
  "publisher": "Anchor Books",
  "language": "English"
}

### Get the book created above
GET {{localhost}}/books/{{localNewBook.response.body.$.id}}

### Update the book created above (204). The genre changes to Literary Fiction.
PUT {{localhost}}/books/{{localNewBook.response.body.$.id}}
Content-Type: application/json

{
  "title": "No Longer at Ease",
  "author": "Chinua Achebe",
  "isbn": "9780385474559",
  "genre": "Literary Fiction",
  "publishedYear": 1960,
  "pageCount": 194,
  "publisher": "Anchor Books",
  "language": "English"
}

### Get the book again to see the update
GET {{localhost}}/books/{{localNewBook.response.body.$.id}}

### Update the book created above with missing fields (400)
PUT {{localhost}}/books/{{localNewBook.response.body.$.id}}
Content-Type: application/json

{
  "title": "No Longer at Ease",
  "genre": "Literary Fiction"
}

### Update the book created above with invalid values (400)
PUT {{localhost}}/books/{{localNewBook.response.body.$.id}}
Content-Type: application/json

{
  "title": "No Longer at Ease",
  "author": "Chinua Achebe",
  "isbn": "9780385474559",
  "genre": "Literary Fiction",
  "publishedYear": "1960",
  "pageCount": 0,
  "publisher": "Anchor Books",
  "language": ""
}

### Update the book created above to the isbn of the first book from "Get all books" (409)
PUT {{localhost}}/books/{{localNewBook.response.body.$.id}}
Content-Type: application/json

{
  "title": "No Longer at Ease",
  "author": "Chinua Achebe",
  "isbn": "{{localBooks.response.body.$[0].isbn}}",
  "genre": "Literary Fiction",
  "publishedYear": 1960,
  "pageCount": 194,
  "publisher": "Anchor Books",
  "language": "English"
}

### Create a book with the same isbn as the book above, written with hyphens (409)
POST {{localhost}}/books
Content-Type: application/json

{
  "title": "No Longer at Ease",
  "author": "Chinua Achebe",
  "isbn": "978-0-385-47455-9",
  "genre": "Literary Fiction",
  "publishedYear": 1960,
  "pageCount": 194,
  "publisher": "Anchor Books",
  "language": "English"
}

### Delete the book created above (200, returns the deleted book)
DELETE {{localhost}}/books/{{localNewBook.response.body.$.id}}

### Get the deleted book (404)
GET {{localhost}}/books/{{localNewBook.response.body.$.id}}

### Create a book with missing fields (400)
POST {{localhost}}/books
Content-Type: application/json

{
  "title": "No Longer at Ease",
  "author": "Chinua Achebe"
}

### Create a book with invalid values (400)
POST {{localhost}}/books
Content-Type: application/json

{
  "title": "No Longer at Ease",
  "author": "Chinua Achebe",
  "isbn": "12345",
  "genre": "Literary Fiction",
  "publishedYear": 3003,
  "pageCount": "one hundred ninety-four",
  "publisher": "Anchor Books",
  "language": "English"
}

### Create a book with a body that is not valid JSON (400)
POST {{localhost}}/books
Content-Type: application/json

{
  "title": "No Longer at Ease",
}

### Update a book with an invalid id (400)
PUT {{localhost}}/books/12345
Content-Type: application/json

{
  "title": "No Longer at Ease",
  "author": "Chinua Achebe",
  "isbn": "9780385474559",
  "genre": "Literary Fiction",
  "publishedYear": 1960,
  "pageCount": 194,
  "publisher": "Anchor Books",
  "language": "English"
}

### Update a book that does not exist (404)
PUT {{localhost}}/books/000000000000000000000000
Content-Type: application/json

{
  "title": "No Longer at Ease",
  "author": "Chinua Achebe",
  "isbn": "9780385474559",
  "genre": "Literary Fiction",
  "publishedYear": 1960,
  "pageCount": 194,
  "publisher": "Anchor Books",
  "language": "English"
}

### Delete a book with an invalid id (400)
DELETE {{localhost}}/books/12345

### Delete a book that does not exist (404)
DELETE {{localhost}}/books/000000000000000000000000

